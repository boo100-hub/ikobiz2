# =============================================================================
# Ikobiz Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp backend/.env.example backend/.env
# =============================================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://ikobiz:ikobiz123@localhost:5432/ikobiz_db

# --- Auth ---
# Secret key for JWT signing. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production

# --- Frontend URL ---
# Used in WhatsApp notifications to generate links back to the platform
SITE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Meta) ---
# Get these from the Meta Developer Portal after creating a WhatsApp Business App
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=ikobiz_verify_123

# --- Groq AI (for WhatsApp chatbot) ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=

# --- WhatsApp Notification Override (optional) ---
# If set, ALL WhatsApp notifications will be sent to this number instead of
# the actual seller/buyer — useful for development/testing.
# Leave blank to send notifications to real users' phones.
# Format: 254XXXXXXXXX (country code + number, no leading +)
NOTIFY_PHONE=
